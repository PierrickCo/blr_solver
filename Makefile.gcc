$(BUILDDIR)/test_blr_workspace: $(BUILDDIR)/blr_kinds_mod.o $(BUILDDIR)/blr_compress_mod.o $(BUILDDIR)/test_blr_workspace.o
	$(FC) -o $@ $(OPTF) $(BUILDDIR)/blr_kinds_mod.o $(BUILDDIR)/blr_compress_mod.o $(BUILDDIR)/test_blr_workspace.o $(LIBS)

$(BUILDDIR)/test_blr_workspace.o: $(TEST)/test_blr_workspace.f90 $(BUILDDIR)/blr_compress_mod.o
	$(FC) $(OPTF) $(INCS) -c $(TEST)/test_blr_workspace.f90 -o $@

# --- Exemples canoniques (examples/) : voir Makefile (chaine Intel) pour
# le detail des dependances -- meme structure, artefacts dans build-gcc/.
EX = examples

