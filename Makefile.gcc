	$(MPIFC) -o $@ $(OPTF) $(BUILDDIR)/blr_kinds_mod.o $(BUILDDIR)/mpi_grid_mod.o $(BUILDDIR)/blr_compress_mod.o $(BUILDDIR)/progress_bar_mod.o $(BUILDDIR)/thread_control_mod.o $(BUILDDIR)/blr_matrix_mod.o $(BUILDDIR)/mpi_blr_lu_pivot_bcast_mod.o $(BUILDDIR)/mpi_lu_pivot_mod.o $(BUILDDIR)/mpi_lu_solve_2d_mod.o $(BUILDDIR)/mpi_blr_matrix_mod.o $(BUILDDIR)/bench_utils_mod.o $(BUILDDIR)/test_mpi_blr_matrix_pivot.o $(MPILIBS)

$(BUILDDIR)/test_mpi_blr_matrix_pivot.o: $(TEST)/test_mpi_blr_matrix_pivot.f90 $(BUILDDIR)/mpi_blr_matrix_mod.o $(BUILDDIR)/mpi_lu_solve_2d_mod.o $(BUILDDIR)/bench_utils_mod.o
	$(MPIFC) $(OPTF) $(INCS) -c $(TEST)/test_mpi_blr_matrix_pivot.f90 -o $@

# --- References A/B : pipeline "matrice compressee de bout en bout" ------
