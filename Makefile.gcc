	$(FC) -o $@ $(OPTF) $(BUILDDIR)/blr_kinds_mod.o $(BUILDDIR)/blr_compress_mod.o $(BUILDDIR)/progress_bar_mod.o $(BUILDDIR)/thread_control_mod.o $(BUILDDIR)/blr_matrix_mod.o $(BUILDDIR)/test_blr_matrix_progress.o $(LIBS)

