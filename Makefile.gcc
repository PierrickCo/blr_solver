# Chaine de build ALTERNATIVE : gcc (gfortran) + BLAS/LAPACK de reference
# (ou OpenBLAS si installe, voir THREAD_IMPL ci-dessous) + OpenMPI. Chemin
# secondaire, pour qui n'a pas de licence Intel oneAPI -- le Makefile
# principal (ifx+MKL+Intel MPI) reste la chaine de reference, testee en
# profondeur tout au long du projet.
#
# TOUS les artefacts (.o/.mod/binaires) vont dans build-gcc/ -- JAMAIS a la
# racine, pour ne jamais melanger avec les .o/.mod du build Intel (formats
# .mod incompatibles entre compilateurs, un melange silencieux corromprait
# le build principal).
#
# Usage :
#   make -f Makefile.gcc            (BLAS/LAPACK de reference, mono-thread)
#   make -f Makefile.gcc THREAD_IMPL=openblas   (si libopenblas-dev installe)
#   make -f Makefile.gcc clean

FC    = gfortran
MPIFC = mpif90
BUILDDIR = build-gcc

# -ffree-line-length-none : plusieurs lignes du projet depassent la limite
# standard de 132 colonnes en forme libre (ifx est plus permissif par
# defaut) -- sans ce flag, gfortran tronque/rejette ces lignes.
OPTF = -O2 -fopenmp -Wall -fcheck=bounds -ffree-line-length-none -J$(BUILDDIR) -I$(BUILDDIR)

SRC  = src
TEST = test

INCS = -I$(SRC)

# THREAD_IMPL controle a la fois quelle implementation de THREAD_CONTROL_MOD
# est compilee (voir src/thread_control_*.f90) et quelle bibliotheque
# BLAS/LAPACK est liee :
#   noop     (defaut) : BLAS/LAPACK de reference Netlib deja installes sur
#                        la plupart des distributions (libblas-dev,
#                        liblapack-dev) -- mono-thread, aucun controle de
#                        threads necessaire (rien a limiter).
#   openblas : necessite `sudo apt install libopenblas-dev` (ou equivalent)
#              au prealable -- multi-thread, garde-fou anti-sursouscription
#              actif comme sous MKL.
THREAD_IMPL ?= noop
ifeq ($(THREAD_IMPL),openblas)
  BLASLIBS = -lopenblas
else
  BLASLIBS = -lblas -llapack
endif
THREAD_SRC = $(SRC)/thread_control_$(THREAD_IMPL).f90

LIBS    = $(BLASLIBS) -lpthread -lm -ldl
MPILIBS = $(LIBS)

all: $(BUILDDIR)/.dirstamp $(BUILDDIR)/test_block_lu $(BUILDDIR)/test_blr_compress $(BUILDDIR)/test_mpi_grid $(BUILDDIR)/test_mpi_lu_pivot $(BUILDDIR)/test_openmp_dense $(BUILDDIR)/test_mpi_lu_solve_2d $(BUILDDIR)/test_blr_matrix_progress $(BUILDDIR)/test_blr_workspace $(BUILDDIR)/test_mpi_blr_matrix $(BUILDDIR)/test_mpi_blr_matrix_pivot $(BUILDDIR)/bench_seq $(BUILDDIR)/bench_mpi $(BUILDDIR)/bench_blr_pipeline

$(BUILDDIR)/.dirstamp:
	mkdir -p $(BUILDDIR)
	touch $@

$(BUILDDIR)/blr_kinds_mod.o: $(SRC)/blr_kinds_mod.f90 $(BUILDDIR)/.dirstamp
	$(FC) $(OPTF) -c $(SRC)/blr_kinds_mod.f90 -o $@

# --- Reference C ----------------------------------------------------------
$(BUILDDIR)/test_block_lu: $(BUILDDIR)/blr_kinds_mod.o $(BUILDDIR)/progress_bar_mod.o $(BUILDDIR)/block_lu_mod.o $(BUILDDIR)/test_block_lu.o
	$(FC) -o $@ $(OPTF) $(BUILDDIR)/blr_kinds_mod.o $(BUILDDIR)/progress_bar_mod.o $(BUILDDIR)/block_lu_mod.o $(BUILDDIR)/test_block_lu.o $(LIBS)

$(BUILDDIR)/block_lu_mod.o: $(SRC)/block_lu_mod.f90 $(BUILDDIR)/blr_kinds_mod.o $(BUILDDIR)/progress_bar_mod.o
	$(FC) $(OPTF) -c $(SRC)/block_lu_mod.f90 -o $@

$(BUILDDIR)/test_block_lu.o: $(TEST)/test_block_lu.f90 $(BUILDDIR)/block_lu_mod.o
	$(FC) $(OPTF) $(INCS) -c $(TEST)/test_block_lu.f90 -o $@

# --- Bibliotheque d'algebre par blocs -------------------------------------
$(BUILDDIR)/test_blr_compress: $(BUILDDIR)/blr_kinds_mod.o $(BUILDDIR)/blr_compress_mod.o $(BUILDDIR)/test_blr_compress.o
	$(FC) -o $@ $(OPTF) $(BUILDDIR)/blr_kinds_mod.o $(BUILDDIR)/blr_compress_mod.o $(BUILDDIR)/test_blr_compress.o $(LIBS)

$(BUILDDIR)/blr_compress_mod.o: $(SRC)/blr_compress_mod.f90 $(BUILDDIR)/blr_kinds_mod.o
	$(FC) $(OPTF) -c $(SRC)/blr_compress_mod.f90 -o $@

$(BUILDDIR)/test_blr_compress.o: $(TEST)/test_blr_compress.f90 $(BUILDDIR)/blr_compress_mod.o
	$(FC) $(OPTF) $(INCS) -c $(TEST)/test_blr_compress.f90 -o $@

# --- Grille de processus + distribution bloc-cyclique 2D ------------------
$(BUILDDIR)/test_mpi_grid: $(BUILDDIR)/blr_kinds_mod.o $(BUILDDIR)/mpi_grid_mod.o $(BUILDDIR)/test_mpi_grid.o
	$(MPIFC) -o $@ $(OPTF) $(BUILDDIR)/blr_kinds_mod.o $(BUILDDIR)/mpi_grid_mod.o $(BUILDDIR)/test_mpi_grid.o $(MPILIBS)

$(BUILDDIR)/mpi_grid_mod.o: $(SRC)/mpi_grid_mod.f90 $(BUILDDIR)/blr_kinds_mod.o
	$(MPIFC) $(OPTF) -c $(SRC)/mpi_grid_mod.f90 -o $@

$(BUILDDIR)/test_mpi_grid.o: $(TEST)/test_mpi_grid.f90 $(BUILDDIR)/mpi_grid_mod.o
	$(MPIFC) $(OPTF) $(INCS) -c $(TEST)/test_mpi_grid.f90 -o $@

# --- Reference MPI (base) --------------------------------------------------
$(BUILDDIR)/test_mpi_lu_pivot: $(BUILDDIR)/blr_kinds_mod.o $(BUILDDIR)/progress_bar_mod.o $(BUILDDIR)/mpi_grid_mod.o $(BUILDDIR)/mpi_lu_pivot_mod.o $(BUILDDIR)/block_lu_mod.o $(BUILDDIR)/test_mpi_lu_pivot.o
	$(MPIFC) -o $@ $(OPTF) $(BUILDDIR)/blr_kinds_mod.o $(BUILDDIR)/progress_bar_mod.o $(BUILDDIR)/mpi_grid_mod.o $(BUILDDIR)/mpi_lu_pivot_mod.o $(BUILDDIR)/block_lu_mod.o $(BUILDDIR)/test_mpi_lu_pivot.o $(MPILIBS)

$(BUILDDIR)/mpi_lu_pivot_mod.o: $(SRC)/mpi_lu_pivot_mod.f90 $(BUILDDIR)/mpi_grid_mod.o $(BUILDDIR)/progress_bar_mod.o
	$(MPIFC) $(OPTF) -c $(SRC)/mpi_lu_pivot_mod.f90 -o $@

$(BUILDDIR)/test_mpi_lu_pivot.o: $(TEST)/test_mpi_lu_pivot.f90 $(BUILDDIR)/mpi_lu_pivot_mod.o $(BUILDDIR)/block_lu_mod.o
	$(MPIFC) $(OPTF) $(INCS) -c $(TEST)/test_mpi_lu_pivot.f90 -o $@

$(BUILDDIR)/mpi_blr_lu_pivot_bcast_mod.o: $(SRC)/mpi_blr_lu_pivot_bcast_mod.f90 $(BUILDDIR)/mpi_grid_mod.o $(BUILDDIR)/blr_compress_mod.o $(BUILDDIR)/mpi_lu_pivot_mod.o
	$(MPIFC) $(OPTF) -c $(SRC)/mpi_blr_lu_pivot_bcast_mod.f90 -o $@

# --- Case "dense + OpenMP" --------------------------------------------------
$(BUILDDIR)/test_openmp_dense: $(BUILDDIR)/blr_kinds_mod.o $(BUILDDIR)/progress_bar_mod.o $(BUILDDIR)/block_lu_mod.o $(BUILDDIR)/test_openmp_dense.o
	$(FC) -o $@ $(OPTF) $(BUILDDIR)/blr_kinds_mod.o $(BUILDDIR)/progress_bar_mod.o $(BUILDDIR)/block_lu_mod.o $(BUILDDIR)/test_openmp_dense.o $(LIBS)

$(BUILDDIR)/test_openmp_dense.o: $(TEST)/test_openmp_dense.f90 $(BUILDDIR)/block_lu_mod.o
	$(FC) $(OPTF) $(INCS) -c $(TEST)/test_openmp_dense.f90 -o $@

# --- Benchmarks de reference (A/B/MPI/C) ----------------------------------
$(BUILDDIR)/bench_utils_mod.o: $(SRC)/bench_utils_mod.f90 $(BUILDDIR)/.dirstamp
	$(FC) $(OPTF) -c $(SRC)/bench_utils_mod.f90 -o $@

$(BUILDDIR)/bench_seq: $(BUILDDIR)/blr_kinds_mod.o $(BUILDDIR)/progress_bar_mod.o $(BUILDDIR)/block_lu_mod.o $(BUILDDIR)/bench_utils_mod.o $(BUILDDIR)/bench_seq.o
	$(FC) -o $@ $(OPTF) $(BUILDDIR)/blr_kinds_mod.o $(BUILDDIR)/progress_bar_mod.o $(BUILDDIR)/block_lu_mod.o $(BUILDDIR)/bench_utils_mod.o $(BUILDDIR)/bench_seq.o $(LIBS)

$(BUILDDIR)/bench_seq.o: $(TEST)/bench_seq.f90 $(BUILDDIR)/block_lu_mod.o $(BUILDDIR)/bench_utils_mod.o
	$(FC) $(OPTF) $(INCS) -c $(TEST)/bench_seq.f90 -o $@

$(BUILDDIR)/bench_mpi: $(BUILDDIR)/blr_kinds_mod.o $(BUILDDIR)/progress_bar_mod.o $(BUILDDIR)/mpi_grid_mod.o $(BUILDDIR)/mpi_lu_pivot_mod.o $(BUILDDIR)/mpi_lu_solve_2d_mod.o $(BUILDDIR)/block_lu_mod.o $(BUILDDIR)/bench_utils_mod.o $(BUILDDIR)/bench_mpi.o
	$(MPIFC) -o $@ $(OPTF) $(BUILDDIR)/blr_kinds_mod.o $(BUILDDIR)/progress_bar_mod.o $(BUILDDIR)/mpi_grid_mod.o $(BUILDDIR)/mpi_lu_pivot_mod.o $(BUILDDIR)/mpi_lu_solve_2d_mod.o $(BUILDDIR)/block_lu_mod.o $(BUILDDIR)/bench_utils_mod.o $(BUILDDIR)/bench_mpi.o $(MPILIBS)

$(BUILDDIR)/bench_mpi.o: $(TEST)/bench_mpi.f90 $(BUILDDIR)/mpi_lu_pivot_mod.o $(BUILDDIR)/mpi_lu_solve_2d_mod.o $(BUILDDIR)/block_lu_mod.o $(BUILDDIR)/bench_utils_mod.o
	$(MPIFC) $(OPTF) $(INCS) -c $(TEST)/bench_mpi.f90 -o $@

# --- Resolution MPI distribuee 2D ------------------------------------------
$(BUILDDIR)/test_mpi_lu_solve_2d: $(BUILDDIR)/blr_kinds_mod.o $(BUILDDIR)/progress_bar_mod.o $(BUILDDIR)/mpi_grid_mod.o $(BUILDDIR)/mpi_lu_pivot_mod.o $(BUILDDIR)/mpi_lu_solve_2d_mod.o $(BUILDDIR)/test_mpi_lu_solve_2d.o
	$(MPIFC) -o $@ $(OPTF) $(BUILDDIR)/blr_kinds_mod.o $(BUILDDIR)/progress_bar_mod.o $(BUILDDIR)/mpi_grid_mod.o $(BUILDDIR)/mpi_lu_pivot_mod.o $(BUILDDIR)/mpi_lu_solve_2d_mod.o $(BUILDDIR)/test_mpi_lu_solve_2d.o $(MPILIBS)

$(BUILDDIR)/mpi_lu_solve_2d_mod.o: $(SRC)/mpi_lu_solve_2d_mod.f90 $(BUILDDIR)/mpi_grid_mod.o $(BUILDDIR)/mpi_lu_pivot_mod.o $(BUILDDIR)/progress_bar_mod.o
	$(MPIFC) $(OPTF) -c $(SRC)/mpi_lu_solve_2d_mod.f90 -o $@

$(BUILDDIR)/test_mpi_lu_solve_2d.o: $(TEST)/test_mpi_lu_solve_2d.f90 $(BUILDDIR)/mpi_lu_pivot_mod.o $(BUILDDIR)/mpi_lu_solve_2d_mod.o
	$(MPIFC) $(OPTF) $(INCS) -c $(TEST)/test_mpi_lu_solve_2d.f90 -o $@

# --- Solveur BLR+MPI (sans et avec pivot) ----------------------------------
$(BUILDDIR)/thread_control_mod.o: $(THREAD_SRC) $(BUILDDIR)/.dirstamp
	$(FC) $(OPTF) -c $(THREAD_SRC) -o $@

$(BUILDDIR)/progress_bar_mod.o: $(SRC)/progress_bar_mod.f90 $(BUILDDIR)/.dirstamp
	$(FC) $(OPTF) -c $(SRC)/progress_bar_mod.f90 -o $@

$(BUILDDIR)/blr_matrix_mod.o: $(SRC)/blr_matrix_mod.f90 $(BUILDDIR)/blr_compress_mod.o $(BUILDDIR)/progress_bar_mod.o $(BUILDDIR)/thread_control_mod.o
	$(FC) $(OPTF) -c $(SRC)/blr_matrix_mod.f90 -o $@

$(BUILDDIR)/mpi_blr_matrix_mod.o: $(SRC)/mpi_blr_matrix_mod.f90 $(BUILDDIR)/mpi_grid_mod.o $(BUILDDIR)/blr_compress_mod.o $(BUILDDIR)/blr_matrix_mod.o $(BUILDDIR)/mpi_blr_lu_pivot_bcast_mod.o $(BUILDDIR)/progress_bar_mod.o $(BUILDDIR)/bench_utils_mod.o
	$(MPIFC) $(OPTF) -c $(SRC)/mpi_blr_matrix_mod.f90 -o $@

$(BUILDDIR)/test_mpi_blr_matrix: $(BUILDDIR)/blr_kinds_mod.o $(BUILDDIR)/mpi_grid_mod.o $(BUILDDIR)/blr_compress_mod.o $(BUILDDIR)/progress_bar_mod.o $(BUILDDIR)/thread_control_mod.o $(BUILDDIR)/blr_matrix_mod.o $(BUILDDIR)/mpi_blr_lu_pivot_bcast_mod.o $(BUILDDIR)/mpi_lu_pivot_mod.o $(BUILDDIR)/mpi_lu_solve_2d_mod.o $(BUILDDIR)/mpi_blr_matrix_mod.o $(BUILDDIR)/bench_utils_mod.o $(BUILDDIR)/test_mpi_blr_matrix.o
	$(MPIFC) -o $@ $(OPTF) $(BUILDDIR)/blr_kinds_mod.o $(BUILDDIR)/mpi_grid_mod.o $(BUILDDIR)/blr_compress_mod.o $(BUILDDIR)/progress_bar_mod.o $(BUILDDIR)/thread_control_mod.o $(BUILDDIR)/blr_matrix_mod.o $(BUILDDIR)/mpi_blr_lu_pivot_bcast_mod.o $(BUILDDIR)/mpi_lu_pivot_mod.o $(BUILDDIR)/mpi_lu_solve_2d_mod.o $(BUILDDIR)/mpi_blr_matrix_mod.o $(BUILDDIR)/bench_utils_mod.o $(BUILDDIR)/test_mpi_blr_matrix.o $(MPILIBS)

