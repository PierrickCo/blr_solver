# LDL^T BLR+MPI -- chaine gcc (gfortran + BLAS/LAPACK + OpenMPI), pendant
# de ldlt/Makefile. PREREQUIS : `make -f Makefile.gcc` depuis blr_solver/
# (reutilise ../build-gcc/*.o/.mod). Artefacts dans ldlt/build-gcc/.
# Necessite LAPACK >= 3.7 (CSYTRF_RK).

MPIFC    = mpif90
# CHECK=0 (`make CHECK=0`) : compile SANS verification des bornes de
# tableaux. Utile au developpement, couteuse a l'execution -- mesure
# (N=40000, NB=500) : assemblage x2.4 (LDLt) a x3.5 (LU), factorisation LU
# x1.7, resolution x1.1 a x1.4. Recommande pour les calculs de production ;
# meme option que le Makefile.gcc racine,
# qui doit avoir ete construit avec. Sorties dans des repertoires separes (suffixe
# _nocheck) : make ne detecte pas un changement d'options.
CHECK ?= 1
ifeq ($(CHECK),0)
  CHECKF =
  CHKSUFFIX = _nocheck
else
  CHECKF = -fcheck=bounds
  CHKSUFFIX =
endif

# FAST=1 (`make FAST=1`) : -O3 et jeu d'instructions de la machine qui
# compile (FAST_ARCH, defaut -march=native). Sur un cluster, compiler sur un noeud
# de calcul, ou fixer l'architecture des noeuds : FAST_ARCH=-march=skylake-avx512 par exemple.
# Mesure (N=40000, NB=500, sans OpenMP ni verification des bornes) :
# assemblage x1.8 (LU) a x2.6 (LDLt) plus rapide qu'en -O2 (evaluation du
# noyau de la matrice vectorisee) ; factorisation et resolution : effet
# variable selon le cas (-8 % a +30 %), a mesurer sur sa propre matrice.
# Meme option que le Makefile.gcc racine ; sorties suffixees _fast.
FAST ?= 0
FAST_ARCH ?= -march=native
ifeq ($(FAST),1)
  OPTLEVEL = -O3 $(FAST_ARCH)
  FASTSUFFIX = _fast
else
  OPTLEVEL = -O2
  FASTSUFFIX =
endif

BUILDDIR = build-gcc$(CHKSUFFIX)$(FASTSUFFIX)
MAIN     = ../build-gcc$(CHKSUFFIX)$(FASTSUFFIX)
SRC      = src
TEST     = test
EX       = examples

OPTF = $(OPTLEVEL) -fopenmp -Wall $(CHECKF) -ffree-line-length-none -J$(BUILDDIR) -I$(MAIN)

$(shell mkdir -p $(BUILDDIR))

THREAD_IMPL ?= noop
ifeq ($(THREAD_IMPL),openblas)
  BLASLIBS = -lopenblas
else
  BLASLIBS = -lblas -llapack
endif
MPILIBS = $(BLASLIBS) -lpthread -lm -ldl

MAIN_OBJS = $(MAIN)/blr_kinds_mod.o $(MAIN)/mpi_grid_mod.o $(MAIN)/blr_compress_mod.o \
            $(MAIN)/blr_arena_mod.o $(MAIN)/blr_ooc_mod.o $(MAIN)/progress_bar_mod.o \
            $(MAIN)/thread_control_mod.o $(MAIN)/blr_matrix_mod.o $(MAIN)/mpi_blr_lu_pivot_bcast_mod.o \
            $(MAIN)/mpi_lu_pivot_mod.o $(MAIN)/mpi_lu_solve_2d_mod.o $(MAIN)/mpi_blr_matrix_mod.o \
            $(MAIN)/bench_utils_mod.o

LDLT_OBJS = $(BUILDDIR)/mpi_blr_ldlt_mod.o $(BUILDDIR)/mpi_blr_ldlt_arena_mod.o $(BUILDDIR)/mpi_blr_ldlt_ooc_mod.o $(BUILDDIR)/sym_testmat_mod.o

all: $(BUILDDIR)/test_mpi_blr_ldlt $(BUILDDIR)/test_mpi_blr_ldlt_arena $(BUILDDIR)/test_mpi_blr_ldlt_ooc $(BUILDDIR)/example_blr_mpi_ldlt $(BUILDDIR)/bench_ldlt_vs_lu $(BUILDDIR)/bench_steps $(BUILDDIR)/sweep_driver

$(BUILDDIR)/mpi_blr_ldlt_mod.o: $(SRC)/mpi_blr_ldlt_mod.f90 $(MAIN)/mpi_blr_matrix_mod.o
	$(MPIFC) $(OPTF) -c $(SRC)/mpi_blr_ldlt_mod.f90 -o $@

$(BUILDDIR)/mpi_blr_ldlt_arena_mod.o: $(SRC)/mpi_blr_ldlt_arena_mod.f90 $(BUILDDIR)/mpi_blr_ldlt_mod.o
	$(MPIFC) $(OPTF) -c $(SRC)/mpi_blr_ldlt_arena_mod.f90 -o $@

$(BUILDDIR)/test_mpi_blr_ldlt_arena.o: $(TEST)/test_mpi_blr_ldlt_arena.f90 $(LDLT_OBJS)
	$(MPIFC) $(OPTF) -c $(TEST)/test_mpi_blr_ldlt_arena.f90 -o $@

$(BUILDDIR)/test_mpi_blr_ldlt_arena: $(MAIN_OBJS) $(LDLT_OBJS) $(BUILDDIR)/test_mpi_blr_ldlt_arena.o
	$(MPIFC) -o $@ $(OPTF) $^ $(MPILIBS)

$(BUILDDIR)/mpi_blr_ldlt_ooc_mod.o: $(SRC)/mpi_blr_ldlt_ooc_mod.f90 $(BUILDDIR)/mpi_blr_ldlt_mod.o
	$(MPIFC) $(OPTF) -c $(SRC)/mpi_blr_ldlt_ooc_mod.f90 -o $@

$(BUILDDIR)/test_mpi_blr_ldlt_ooc.o: $(TEST)/test_mpi_blr_ldlt_ooc.f90 $(LDLT_OBJS)
	$(MPIFC) $(OPTF) -c $(TEST)/test_mpi_blr_ldlt_ooc.f90 -o $@

$(BUILDDIR)/test_mpi_blr_ldlt_ooc: $(MAIN_OBJS) $(LDLT_OBJS) $(BUILDDIR)/test_mpi_blr_ldlt_ooc.o
	$(MPIFC) -o $@ $(OPTF) $^ $(MPILIBS)

$(BUILDDIR)/sweep_driver.o: $(TEST)/sweep_driver.f90 $(LDLT_OBJS)
	$(MPIFC) $(OPTF) -c $(TEST)/sweep_driver.f90 -o $@

$(BUILDDIR)/sweep_driver: $(MAIN_OBJS) $(LDLT_OBJS) $(BUILDDIR)/sweep_driver.o
	$(MPIFC) -o $@ $(OPTF) $^ $(MPILIBS)

$(BUILDDIR)/sym_testmat_mod.o: $(SRC)/sym_testmat_mod.f90 $(MAIN)/blr_kinds_mod.o
	$(MPIFC) $(OPTF) -c $(SRC)/sym_testmat_mod.f90 -o $@

$(BUILDDIR)/test_mpi_blr_ldlt.o: $(TEST)/test_mpi_blr_ldlt.f90 $(LDLT_OBJS)
	$(MPIFC) $(OPTF) -c $(TEST)/test_mpi_blr_ldlt.f90 -o $@

$(BUILDDIR)/test_mpi_blr_ldlt: $(MAIN_OBJS) $(LDLT_OBJS) $(BUILDDIR)/test_mpi_blr_ldlt.o
	$(MPIFC) -o $@ $(OPTF) $^ $(MPILIBS)

$(BUILDDIR)/example_blr_mpi_ldlt.o: $(EX)/example_blr_mpi_ldlt.f90 $(LDLT_OBJS)
	$(MPIFC) $(OPTF) -c $(EX)/example_blr_mpi_ldlt.f90 -o $@

$(BUILDDIR)/example_blr_mpi_ldlt: $(MAIN_OBJS) $(LDLT_OBJS) $(BUILDDIR)/example_blr_mpi_ldlt.o
	$(MPIFC) -o $@ $(OPTF) $^ $(MPILIBS)

$(BUILDDIR)/bench_ldlt_vs_lu.o: $(TEST)/bench_ldlt_vs_lu.f90 $(LDLT_OBJS)
	$(MPIFC) $(OPTF) -c $(TEST)/bench_ldlt_vs_lu.f90 -o $@

$(BUILDDIR)/bench_ldlt_vs_lu: $(MAIN_OBJS) $(LDLT_OBJS) $(BUILDDIR)/bench_ldlt_vs_lu.o
	$(MPIFC) -o $@ $(OPTF) $^ $(MPILIBS)

$(BUILDDIR)/bench_steps.o: $(TEST)/bench_steps.f90 $(LDLT_OBJS)
	$(MPIFC) $(OPTF) -c $(TEST)/bench_steps.f90 -o $@

$(BUILDDIR)/bench_steps: $(MAIN_OBJS) $(LDLT_OBJS) $(BUILDDIR)/bench_steps.o
	$(MPIFC) -o $@ $(OPTF) $^ $(MPILIBS)

clean:
	rm -rf $(BUILDDIR)

.PHONY: all clean
