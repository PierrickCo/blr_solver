# Artefacts de compilation (Intel oneAPI, gcc, ifort 2019) -- rangement
# bin/ (executables, tests/benchmarks a la racine ET exemples) + lib/
# (.o/.mod partages), voir le Makefile principal. Les .o propres a chaque
# exemple restent dans examples/ (ligne dediee plus bas).
bin/
lib/
build-gcc/
build-ifort2019/
examples/*.o

# Binaire du micro-benchmark de diagnostic (pas dans le Makefile,
# compile manuellement -- voir test/bench_arena_hypothesis.f90)
bench_arena_hypothesis

# legacy/ n'a pas son propre repertoire bin/lib (mis de cote, jamais
# reorganise) -- ses .o/.mod restent a plat dans legacy/.
legacy/*.o
legacy/*.mod

# Binaires legacy/
legacy/test_ldlt
legacy/test_blr_ldlt
legacy/test_mpi_matvec
legacy/test_mpi_lu_nopiv
legacy/test_mpi_lu_solve
legacy/test_mpi_blr_lu_pivot
legacy/test_mpi_blr_lu_pivot_bcast
legacy/test_mpi_blr_lu_nopiv
legacy/test_blr_lu
legacy/test_blr_lu_storage
legacy/test_pivoting
legacy/test_openmp
legacy/bench_seq_full
legacy/bench_mpi_full

# user_case/ : construit par le Makefile principal comme les exemples de
# examples/ -- ses modules (.o/.mod) rejoignent lib/ (deja ignore
# ci-dessus), seul le .o du programme principal reste dans user_case/
# (meme convention que examples/*.o), l'executable rejoint bin/.
user_case/*.o

# Sorties de scripts (regenerables, pas versionnees)
run_all_tests_logs/

# Fichiers de scratch out-of-core (voir src/blr_ooc_mod.f90) : crees a
# l'execution dans un sous-dossier relatif au repertoire de lancement,
# jamais a versionner.
blr_ooc_scratch*/

# Graphe de dependances genere par tools/analyze_deps.py (regenerable,
# pas versionne).
depgraph.json

# Profils RSS/CPU par etape (PROFILE_USAGE, example_blr_mpi_pivot.f90) et
# le graphe genere -- un fichier par run, jamais a versionner.
usage_profile_rank*.csv
usage_profile.png

# Structure BLR par bloc (DUMP_STRUCTURE, example_blr_mpi_pivot.f90) et
# le graphe genere -- idem, un fichier par run.
blr_structure_*.csv
blr_structure.png
