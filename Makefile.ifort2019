	$(MPIFC) -o $@ $(OPTF) $(BUILDDIR)/blr_kinds_mod.o $(BUILDDIR)/progress_bar_mod.o $(BUILDDIR)/mpi_grid_mod.o $(BUILDDIR)/mpi_lu_pivot_mod.o $(BUILDDIR)/mpi_lu_solve_2d_mod.o $(BUILDDIR)/test_mpi_lu_solve_2d.o $(MPILIBS)

$(BUILDDIR)/mpi_lu_solve_2d_mod.o: $(SRC)/mpi_lu_solve_2d_mod.f90 $(BUILDDIR)/mpi_grid_mod.o $(BUILDDIR)/mpi_lu_pivot_mod.o $(BUILDDIR)/progress_bar_mod.o
	$(MPIFC) $(OPTF) -c $(SRC)/mpi_lu_solve_2d_mod.f90 -o $@

$(BUILDDIR)/test_mpi_lu_solve_2d.o: $(TEST)/test_mpi_lu_solve_2d.f90 $(BUILDDIR)/mpi_lu_pivot_mod.o $(BUILDDIR)/mpi_lu_solve_2d_mod.o
	$(MPIFC) $(OPTF) $(INCS) -c $(TEST)/test_mpi_lu_solve_2d.f90 -o $@

# --- Solveur BLR+MPI (sans et avec pivot) ----------------------------------
$(BUILDDIR)/thread_control_mod.o: $(SRC)/thread_control_mkl.f90 $(BUILDDIR)/.dirstamp
	$(FC) $(OPTF) -c $(SRC)/thread_control_mkl.f90 -o $@

$(BUILDDIR)/progress_bar_mod.o: $(SRC)/progress_bar_mod.f90 $(BUILDDIR)/.dirstamp
	$(FC) $(OPTF) -c $(SRC)/progress_bar_mod.f90 -o $@

$(BUILDDIR)/blr_matrix_mod.o: $(SRC)/blr_matrix_mod.f90 $(BUILDDIR)/blr_compress_mod.o $(BUILDDIR)/progress_bar_mod.o $(BUILDDIR)/thread_control_mod.o
