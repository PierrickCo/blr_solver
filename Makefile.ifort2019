$(BUILDDIR)/example_blr_mpi_pivot.o: $(EX)/example_blr_mpi_pivot.f90 $(BUILDDIR)/mpi_blr_matrix_mod.o $(BUILDDIR)/mpi_lu_solve_2d_mod.o $(BUILDDIR)/bench_utils_mod.o
	$(MPIFC) $(OPTF) $(INCS) -c $(EX)/example_blr_mpi_pivot.f90 -o $@

examples: $(BUILDDIR)/example_blr_sequentiel $(BUILDDIR)/example_dense_sequentiel $(BUILDDIR)/example_mpi_dense $(BUILDDIR)/example_blr_mpi_sans_pivot $(BUILDDIR)/example_blr_mpi_pivot

clean:
	$(RM) -r $(BUILDDIR)
